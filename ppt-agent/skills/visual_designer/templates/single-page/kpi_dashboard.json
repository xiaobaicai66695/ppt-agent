{
  "name": "kpi_dashboard",
  "display_name": "仪表盘页",
  "type": "atomic",
  "description": "关键绩效指标仪表盘，展示核心业务指标",
  "allowed_palettes": ["ocean_soft", "charcoal_light", "warm_terracotta", "report_green", "finance_gold"],
  "contract": {
    "capacity": {
      "max_items": 4,
      "min_items": 2,
      "max_label_chars": 18,
      "density": "high"
    },
    "required_fields": ["title", "kpis"],
    "best_for": ["核心指标", "经营看板", "结果对比"],
    "avoid_for": ["无数字内容", "长段解释", "多维明细表"],
    "overflow_strategy": "split_metrics_or_use_chart_slide",
    "background_policy": "clean_default",
    "visual_primitives": ["stat_cards", "trend_badges", "shape_sparklines"]
  },
  "fields": [
    {"name": "title", "label": "页面标题", "type": "text", "required": true},
    {"name": "metrics", "label": "指标数据", "type": "textarea", "required": true}
  ]
}
