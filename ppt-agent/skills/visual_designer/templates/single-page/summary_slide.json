{
  "name": "summary_slide",
  "display_name": "总结页",
  "type": "atomic",
  "description": "演示文稿总结页，回顾核心要点和展望",
  "allowed_palettes": ["ocean_soft", "sage_calm", "charcoal_light", "education_blue", "civic_gold", "government_red"],
  "contract": {
    "capacity": {
      "max_items": 4,
      "max_chars_per_item": 38,
      "density": "normal"
    },
    "required_fields": ["title", "key_points"],
    "best_for": ["总结收束", "核心结论", "行动建议"],
    "avoid_for": ["新增复杂论证", "长表格", "多图表"],
    "overflow_strategy": "split_takeaways_or_add_appendix",
    "background_policy": "image_optional",
    "visual_primitives": ["summary_cards", "check_marks", "local_icons"]
  },
  "fields": [
    {"name": "title", "label": "页面标题", "type": "text", "required": true},
    {"name": "summary", "label": "核心要点", "type": "textarea", "required": true},
    {"name": "outlook", "label": "未来展望", "type": "textarea", "required": false}
  ]
}
