{
  "name": "agenda",
  "display_name": "目录页",
  "type": "atomic",
  "description": "演示文稿目录，列出各章节标题和内容概览",
  "allowed_palettes": ["ocean_soft", "sage_calm", "charcoal_light", "education_blue"],
  "contract": {
    "capacity": {
      "max_items": 6,
      "max_chars_per_item": 24,
      "density": "normal"
    },
    "required_fields": ["title", "items"],
    "best_for": ["目录", "章节清单", "演讲路径"],
    "avoid_for": ["长段解释", "数据图表", "案例细节"],
    "overflow_strategy": "split_agenda_or_group_items",
    "background_policy": "clean_default",
    "visual_primitives": ["number_markers", "divider_shapes", "local_icons"]
  },
  "fields": [
    {"name": "title", "label": "目录标题", "type": "text", "required": true},
    {"name": "items", "label": "目录项", "type": "textarea", "required": true}
  ]
}
