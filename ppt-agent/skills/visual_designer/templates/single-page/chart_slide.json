{
  "name": "chart_slide",
  "display_name": "图表专页",
  "type": "atomic",
  "description": "专业数据可视化页面，支持柱状图、饼图、折线图、环形图等多种图表类型",
  "allowed_palettes": ["ocean_soft", "sage_calm", "charcoal_light", "warm_terracotta", "report_green", "finance_gold"],
  "fields": [
    {"name": "title", "label": "页面标题", "type": "text", "required": true},
    {"name": "subtitle", "label": "副标题", "type": "text", "required": false},
    {"name": "kicker", "label": "领域标签", "type": "text", "required": false},
    {"name": "chart_type", "label": "图表类型", "type": "select", "required": true, "options": ["bar", "pie", "line", "doughnut", "stacked_bar"]},
    {"name": "chart_data", "label": "图表数据(JSON格式)", "type": "textarea", "required": true, "placeholder": "{\"labels\":[\"Q1\",\"Q2\",\"Q3\"],\"datasets\":[{\"name\":\"2025年\",\"values\":[1200,1500,1800]}]}"},
    {"name": "analysis", "label": "数据分析文字", "type": "textarea", "required": false, "placeholder": "分析文字将显示在图表右侧，为数据提供解读和洞察"}
  ]
}
