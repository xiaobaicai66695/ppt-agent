{
  "name": "image_text",
  "display_name": "图文排版页",
  "type": "atomic",
  "description": "左侧图片或图示，右侧文字说明的布局",
  "allowed_palettes": ["ocean_soft", "sage_calm", "charcoal_light", "education_blue", "warm_terracotta"],
  "contract": {
    "capacity": {
      "max_paragraph_chars": 450,
      "min_paragraph_chars": 260,
      "density": "normal"
    },
    "required_fields": ["title", "paragraph"],
    "best_for": ["图文解释", "案例叙事", "产品或场景说明"],
    "avoid_for": ["纯 bullet 列表", "复杂数据", "无视觉对象内容"],
    "overflow_strategy": "split_text_or_use_deep_dive",
    "background_policy": "image_optional",
    "visual_primitives": ["local_shapes", "image_placeholder", "caption"]
  },
  "fields": [
    {"name": "title", "label": "页面标题", "type": "text", "required": true},
    {"name": "image_desc", "label": "图片描述", "type": "text", "required": false},
    {"name": "text_content", "label": "文字内容", "type": "textarea", "required": true}
  ]
}
