{
  "name": "three_column",
  "display_name": "三栏布局页",
  "type": "atomic",
  "description": "三栏并列布局，适合展示三个方面或三个案例",
  "allowed_palettes": ["ocean_soft", "sage_calm", "charcoal_light", "education_blue", "warm_terracotta", "berry_cream"],
  "contract": {
    "capacity": {
      "min_items_per_column": 2,
      "max_items_per_column": 4,
      "target_chars_per_item_min": 35,
      "target_chars_per_item_max": 65,
      "max_chars_per_item": 80,
      "density": "normal"
    },
    "required_fields": ["title", "columns"],
    "best_for": ["三个并列维度", "三类方案", "阶段性观点"],
    "avoid_for": ["长篇叙事", "四项以上对比", "复杂数据表"],
    "overflow_strategy": "split_columns_or_use_card_grid",
    "background_policy": "clean_default",
    "visual_primitives": ["column_panels", "local_icons", "accent_headers"]
  },
  "fields": [
    {"name": "title", "label": "页面标题", "type": "text", "required": true},
    {"name": "col1_title", "label": "第一栏标题", "type": "text", "required": true},
    {"name": "col1_content", "label": "第一栏内容", "type": "textarea", "required": true},
    {"name": "col2_title", "label": "第二栏标题", "type": "text", "required": true},
    {"name": "col2_content", "label": "第二栏内容", "type": "textarea", "required": true},
    {"name": "col3_title", "label": "第三栏标题", "type": "text", "required": true},
    {"name": "col3_content", "label": "第三栏内容", "type": "textarea", "required": true}
  ]
}
