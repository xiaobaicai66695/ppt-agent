{
  "name": "two_column",
  "display_name": "双栏对比页",
  "type": "atomic",
  "description": "左右两栏布局，适合对比分析或并列展示",
  "allowed_palettes": ["ocean_soft", "sage_calm", "charcoal_light", "education_blue", "warm_terracotta", "berry_cream", "civic_gold"],
  "contract": {
    "capacity": {
      "max_items_per_column": 5,
      "max_chars_per_item": 34,
      "max_intro_chars": 80,
      "density": "normal"
    },
    "required_fields": ["title", "left_header", "right_header"],
    "best_for": ["双方案对比", "左右并列分析", "利弊权衡"],
    "avoid_for": ["三项以上对比", "指标仪表盘", "单栏叙事"],
    "overflow_strategy": "split_by_dimension_or_use_comparison_table",
    "background_policy": "clean_default",
    "visual_primitives": ["column_panels", "comparison_markers", "local_icons"]
  },
  "fields": [
    {"name": "title", "label": "页面标题", "type": "text", "required": true},
    {"name": "left_title", "label": "左栏标题", "type": "text", "required": true},
    {"name": "left_content", "label": "左栏内容", "type": "textarea", "required": true},
    {"name": "right_title", "label": "右栏标题", "type": "text", "required": true},
    {"name": "right_content", "label": "右栏内容", "type": "textarea", "required": true}
  ]
}
