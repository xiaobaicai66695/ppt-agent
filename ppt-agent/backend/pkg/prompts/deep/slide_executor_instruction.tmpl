    ],
)

# timeline 示例：从描述中提取 nodes
generate_timeline(
    prs=prs,
    palette="ocean_soft",
    title="2026年4-5月党政大事时间线",
    direction="horizontal",
    nodes=[
        {"year": "4月7日", "event": "全国服务业大会召开", "icon": "1"},
